# ====================================================================
# Global Supply Chain Digital Twin Platform - Environment Configuration
# ====================================================================

# Platform Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super_secret_jwt_key_global_supply_chain_digital_twin_2026

# PostgreSQL Database Configuration (Bronze / Silver / Gold Lakehouse DWH)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supply_chain_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/supply_chain_db

# MinIO Object Storage (S3-Compatible Data Lake)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=supply-chain-bronze
MINIO_BUCKET_SILVER=supply-chain-silver
MINIO_BUCKET_GOLD=supply-chain-gold

# Apache Kafka Event Streaming Cluster
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_SPARK=spark-streaming-group
KAFKA_CONSUMER_GROUP_BACKEND=digital-twin-backend-group

# Apache Spark Cluster
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APP_NAME=GlobalSupplyChainStreamingProcessor

# Apache Airflow Orchestrator
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/supply_chain_db
AIRFLOW__CORE__FERNET_KEY=46ExbZLiAsAy0Dx_154_YhMkcB5QUsdf29w_89asdsa=
AIRFLOW__CORE__LOAD_EXAMPLES=False

# FastAPI Backend Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8050,http://localhost:5173

# Monitoring Stack
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
